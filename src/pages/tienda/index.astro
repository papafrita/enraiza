---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Wave from '../../components/Wave.astro';
import Icon from '../../components/Icon.astro';
import { getModelos, shapes, sizes, modeloHref } from '../../lib/modelos';
import { waLink } from '../../site.config';
import medirPie from '../../assets/medir-pie.png';
import manio from '../../assets/modelos/manio.png';
import greenShoes from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.01 PM.jpeg';
import pinkShoes from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.18 PM.jpeg';
import blackBoots from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.19 PM (3).jpeg';
import materialsAndTools from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.17 PM.jpeg';
import measuredCut from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.20 PM (2).jpeg';
import handAssembly from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.21 PM.jpeg';
import handFinish from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.18 PM (1).jpeg';
import finishedBoots from '../../assets/new_material/WhatsApp Image 2026-10-12 at 10.58.19 PM (3).jpeg';

const modelos = await getModelos();

const steps = [
  { title: 'Selección de materiales', text: 'Elegimos cueros naturales de buena calidad con cuidado.', image: materialsAndTools, alt: 'Zapato de cuero junto a herramientas y materiales del taller' },
  { title: 'Corte a medida', text: 'Preparamos cada pieza pensando en la forma única de tus pies.', image: measuredCut, alt: 'Artesana trabajando cuidadosamente una pieza de calzado' },
  { title: 'Ensamblado artesanal', text: 'Unimos las piezas a mano con dedicación y precisión.', image: handAssembly, alt: 'Artesana dando forma a un zapato en su mesa de trabajo' },
  { title: 'Terminaciones y detalles', text: 'Revisamos cada detalle para que tu par sea único y duradero.', image: handFinish, alt: 'Manos ajustando los detalles de un par de zapatos' },
  { title: 'Listo para acompañarte', text: 'Tu par queda listo para acompañarte en cada paso.', image: finishedBoots, alt: 'Botines terminados fotografiados entre hojas de otoño' },
];

const measure = [
  'Pon una hoja en el suelo junto a una pared y apoya el talón contra ella, de pie y con tu peso.',
  'Marca la punta del dedo más largo y el contorno del pie.',
  'Mide del talón a la marca en centímetros y busca tu talla en la tabla.',
];
const sizeCols = [sizes.slice(0, 6), sizes.slice(6)];
---

<Base
  title="Tienda"
  description="Modelos de calzado respetuoso hechos a mano y a medida en Valdivia: Mañío, Tepa, Chilca y Korü. Guía para medir tu pie y tabla de tallas."
  ogImage={manio}
>
  <section class="container intro">
    <div class="intro-blob" aria-hidden="true"></div>
    <h1 class="h1">Tienda</h1>
    <p class="lead">
      Cada par se hace a mano y a medida. Elige tu modelo y escríbenos: te ayudamos con la talla, el cuero y el tipo
      de suela.
    </p>
  </section>

  <section class="container listing">
    {
      modelos.map((m, i) => (
        <article class="split" style="--min:380px; --gap:clamp(32px,5vw,72px)">
          <div class:list={['figure', { 'figure--right': i % 2 }]}>
            <div
              class="deco"
              aria-hidden="true"
              style={`left:-5%;top:-7%;width:34%;background:${i % 2 ? 'var(--sage-light)' : 'var(--orange)'}`}
            />
            <Picture
              src={m.data.image}
              alt={m.data.alt}
              widths={[480, 760]}
              sizes="(min-width: 1100px) 560px, (min-width: 820px) 45vw, 100vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              style={`aspect-ratio:4/3;border-radius:${shapes[m.data.shape]}`}
            />
          </div>
          <div class="model-text">
            <span class="kicker">{m.data.kind}</span>
            <h2>{m.data.name}</h2>
            <p class="lead">{m.data.description}</p>
            <div class="btn-row">
              <a href={modeloHref(m)} class="btn btn--orange btn--sm">
                Ver modelo
              </a>
              <a
                href={waLink(`Hola Enraíza, me interesa el modelo ${m.data.name}. ¿Me pueden ayudar con la talla?`)}
                target="_blank"
                rel="noopener"
                class="btn btn--outline btn--sm"
              >
                Consultar por WhatsApp
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="container more-pairs">
    <div class="more-pairs-head">
      <span class="kicker">Pares hechos en el taller</span>
      <h2 class="h2">Colores y detalles para cada camino.</h2>
      <p class="lead">Cada par se trabaja a mano: el cuero y sus terminaciones le dan un carácter propio.</p>
    </div>
    <div class="more-pairs-grid">
      <figure>
        <Picture src={greenShoes} alt="Zapatos verde oliva con cordones claros y suela blanca" widths={[380, 600]} sizes="(min-width: 1000px) 33vw, (min-width: 620px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" />
        <figcaption>Verde oliva y cordones claros</figcaption>
      </figure>
      <figure>
        <Picture src={pinkShoes} alt="Zapatos rosados de cuero con cordones" widths={[380, 600]} sizes="(min-width: 1000px) 33vw, (min-width: 620px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" />
        <figcaption>Color suave, hecho a mano</figcaption>
      </figure>
      <figure>
        <Picture src={blackBoots} alt="Botines negros de cuero y gamuza entre hojas de otoño" widths={[380, 600]} sizes="(min-width: 1000px) 33vw, (min-width: 620px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" />
        <figcaption>Botines listos para el sur</figcaption>
      </figure>
    </div>
  </section>

  <Wave variant="pale" />
  <section class="band--pale">
    <div class="container process">
      <div class="process-head">
        <span class="kicker">Hecho especialmente para ti</span>
        <h2 class="h2">Así creamos tu par, paso a paso</h2>
      </div>
      <ol>
        {
          steps.map((s, i) => (
            <li>
              <div class="step-visual">
                <Picture
                  src={s.image}
                  alt={s.alt}
                  widths={[140, 220]}
                  sizes="(min-width: 1000px) 120px, (min-width: 640px) 100px, 112px"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  class="step-photo"
                />
              <span class:list={['step-n', { 'step-n--sage': i % 2 }]}>
                {i + 1}
              </span>
              </div>
              <span class="step-title">{s.title}</span>
              <span class="step-text">{s.text}</span>
            </li>
          ))
        }
      </ol>
      <aside class="production-note" aria-label="Tiempo de producción aproximado">
        <div class="production-clock" aria-hidden="true">
          <span class="clock-face"><span class="clock-hand clock-hand--hour"></span><span class="clock-hand clock-hand--minute"></span></span>
        </div>
        <div class="production-copy">
          <p>Nuestro tiempo de producción es de</p>
          <h3>aprox. 15 días hábiles.</h3>
          <p>Te contactaremos cuando tu pedido esté listo para coordinar el envío.</p>
        </div>
        <div class="production-thanks">
          <span aria-hidden="true">♡</span>
          <p>Gracias por tu paciencia y por valorar el trabajo hecho a mano.</p>
        </div>
      </aside>
    </div>
  </section>
  <Wave variant="pale" position="bottom" />

  <section id="guia-tallas" class="container split guide">
    <div class="guide-text">
      <span class="kicker"><Icon name="footprints" size={16} color="var(--sage-dark)" />Fisiología natural del pie</span>
      <h2>Aprende a medir tu pie y encuentra tu <span class="accent">talla anatómica</span> perfecta.</h2>
      <p class="lead">
        El calzado convencional oprime los dedos forzando una forma en punta. En Enraíza trabajamos sobre hormas
        barefoot: puntera ancha que respeta la expansión natural de tus dedos y <em>drop cero</em> real.
      </p>
      <div class="callout">
        <span class="callout-icon"><Icon name="ruler" size={26} color="var(--orange-ink)" /></span>
        <div>
          <h3>¿Por qué tu talla comercial no coincide?</h3>
          <p>
            Las marcas industriales miden el zapato por fuera o restringen el empeine. Nosotros medimos la huella viva
            bajo carga y añadimos <strong>8 a 12 mm de holgura funcional</strong> para permitir la marcha natural sin compresión.
          </p>
        </div>
      </div>
    </div>
    <div class="figure guide-figure">
      <div class="deco" aria-hidden="true" style="right:-7%;bottom:-7%;width:48%;background:var(--orange)"></div>
      <Picture
        src={medirPie}
        alt="Artesano marcando el contorno de una plantilla sobre cuero"
        widths={[414]}
        sizes="(min-width: 540px) 500px, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
      />
      <div class="tag">
        <span>Taller Enraíza</span>
        <span>Horma 100% viva</span>
      </div>
    </div>
  </section>

  <section class="container split size-table" style="--min:380px; --gap:clamp(32px,5vw,72px)">
    <div class="measure">
      <h2>Mídelo en casa</h2>
      <ol>
        {
          measure.map((text, i) => (
            <li>
              <span class="measure-n">{i + 1}</span>
              <span>{text}</span>
            </li>
          ))
        }
      </ol>
      <p>¿Estás entre dos medidas? Escríbenos: como hacemos cada par a medida, lo ajustamos a tu pie.</p>
    </div>
    <div class="table-box">
      {
        sizeCols.map((rows) => (
          <table>
            <thead>
              <tr>
                <th scope="col">Cm</th>
                <th scope="col">Talla</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td>{r.cm}</td>
                  <td>{r.talla}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
  }
  .intro-blob {
    position: absolute;
    right: clamp(20px, 6vw, 80px);
    top: clamp(24px, 4vw, 56px);
    width: clamp(90px, 12vw, 160px);
    aspect-ratio: 1;
    border-radius: var(--shape-blob-a);
    background: var(--sage-light);
  }
  .intro h1, .intro p { position: relative; }
  .intro p { max-width: 52ch; }

  .listing {
    padding-top: 32px;
    padding-bottom: clamp(40px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  /* Alterna imagen izq/der solo cuando hay 2 columnas (≥ ~880px). */
  @media (min-width: 880px) {
    .figure--right { order: 2; }
  }
  .model-text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .model-text h2 { font-size: clamp(44px, 5vw, 68px); }
  .model-text p { max-width: 38ch; }
  .model-text .btn-row { gap: 10px; margin-top: 6px; }

  .more-pairs { padding-bottom: clamp(24px, 3vw, 40px); }
  .more-pairs-head { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; margin-bottom: 32px; }
  .more-pairs-head h2 { max-width: 18ch; }
  .more-pairs-head p { max-width: 50ch; }
  .more-pairs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 20px; align-items: start; }
  .more-pairs-grid figure { overflow: hidden; background: var(--sand); border-radius: 48px 48px 48px 14px; }
  .more-pairs-grid figure:nth-child(2) { margin-top: 36px; border-radius: 999px 999px 48px 48px; }
  .more-pairs-grid figure :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .more-pairs-grid figcaption { padding: 16px 20px 20px; font: 400 19px/1.2 var(--font-display); }

  .process {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(32px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .process-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; max-width: 760px; margin-inline: auto; }
  .process-head h2 { max-width: 20ch; }
  .process ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px 18px;
    align-items: start;
  }
  .process li { position: relative; display: flex; flex-direction: column; gap: 10px; align-items: center; text-align: center; }
  .process li:not(:last-child)::after {
    content: '→';
    position: absolute;
    top: 44px;
    right: -15px;
    color: var(--sage-dark);
    font: 600 20px/1 var(--font-body);
  }
  .step-visual { position: relative; flex: none; width: 120px; height: 120px; max-width: 100%; margin-bottom: 4px; }
  .step-visual :global(.step-photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .step-n {
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font: 700 14px/1 var(--font-body);
    color: var(--cream);
    background: var(--orange);
    border: 3px solid var(--sage-pale);
  }
  .step-n--sage { background: var(--sage-dark); }
  .step-title { font: 400 20px/1.15 var(--font-display); max-width: 16ch; }
  .step-text { font-size: 14px; color: var(--ink-soft); max-width: 24ch; }
  .production-note {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(180px, 240px);
    gap: 24px;
    align-items: center;
    padding: 20px 24px;
    background: var(--cream);
    border-radius: 48px 48px 48px 14px;
  }
  .production-clock {
    min-height: 124px;
    border-radius: 28px 12px 28px 28px;
    background: var(--sage-dark);
    color: var(--cream);
    display: grid;
    place-items: center;
  }
  .clock-face { position: relative; width: 68px; aspect-ratio: 1; border: 2px solid var(--cream); border-radius: 50%; }
  .clock-face::after { content: ''; position: absolute; inset: 5px; border: 1px dotted rgba(255, 247, 228, .7); border-radius: 50%; }
  .clock-hand { position: absolute; z-index: 1; left: 50%; bottom: 50%; width: 2px; background: var(--cream); border-radius: 2px; transform-origin: bottom; }
  .clock-hand--hour { height: 19px; transform: translateX(-50%) rotate(-42deg); }
  .clock-hand--minute { height: 25px; transform: translateX(-50%) rotate(18deg); }
  .production-copy { display: flex; flex-direction: column; gap: 10px; }
  .production-copy h3 { font: 400 clamp(27px, 3vw, 38px)/1 var(--font-display); color: var(--ink); }
  .production-copy p { max-width: 46ch; color: var(--ink-soft); font-size: 15px; }
  .production-thanks { background: var(--sand); border-radius: 24px 12px 24px 24px; padding: 16px; text-align: center; color: var(--ink-soft); }
  .production-thanks span { display: block; color: var(--sage-dark); font: 400 26px/1 var(--font-body); margin-bottom: 8px; }
  .production-thanks p { font: italic 14px/1.4 var(--font-body); }

  @media (max-width: 1000px) {
    .process ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .process li::after { display: none; }
    .production-note { grid-template-columns: 110px minmax(0, 1fr); }
    .production-clock { min-height: 108px; }
    .production-thanks { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .process ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 18px; }
    .step-visual { width: 108px; height: 108px; }
    .step-title { font-size: 20px; }
    .production-note { grid-template-columns: 1fr; }
    .production-clock { min-height: 96px; }
    .production-thanks { grid-column: auto; }
    .more-pairs-grid figure:nth-child(2) { margin-top: 0; }
  }
  @media (max-width: 420px) {
    .process ol { grid-template-columns: 1fr; }
  }

  .guide { padding-top: clamp(40px, 5vw, 64px); }
  .guide-text { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .guide-text h2 { font-size: clamp(36px, 4.6vw, 60px); }
  .guide-text .lead { max-width: 44ch; }
  .callout {
    background: var(--sand);
    border-radius: 48px 48px 48px 16px;
    padding: 28px 32px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    max-width: 560px;
  }
  .callout-icon {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--cream);
    display: grid;
    place-items: center;
  }
  .callout div { display: flex; flex-direction: column; gap: 8px; }
  .callout h3 { font-size: 22px; }
  .callout p { font-size: 16px; color: var(--ink-soft); }
  .callout strong { color: var(--orange-ink); }
  .guide-figure { justify-self: center; width: min(100%, 500px); }
  .guide-figure :global(img) { aspect-ratio: 4/5; border-radius: 44% 56% 40px 40px / 34% 34% 40px 40px; }
  .tag {
    position: absolute;
    left: 6%;
    bottom: 6%;
    background: var(--cream);
    border-radius: 999px;
    padding: 12px 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tag span:first-child {
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-dark);
  }
  .tag span:last-child { font: 400 18px/1.2 var(--font-display); }

  .size-table { padding-top: clamp(40px, 5vw, 64px); align-items: start; }
  .measure { display: flex; flex-direction: column; gap: 28px; }
  .measure h2 { font-size: clamp(32px, 3.8vw, 48px); }
  .measure ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .measure li { display: flex; gap: 16px; align-items: flex-start; }
  .measure li span:last-child { padding-top: 9px; max-width: 40ch; }
  .measure-n {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--sage-light);
    display: grid;
    place-items: center;
    font: 400 20px/1 var(--font-display);
  }
  .measure > p { font-size: 16px; max-width: 42ch; color: var(--ink-soft); }
  .table-box {
    background: var(--sage);
    border-radius: 64px 40px 72px 40px;
    padding: clamp(24px, 3vw, 36px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
  }
  table { width: 100%; border-collapse: separate; border-spacing: 0 6px; font-size: 17px; }
  th {
    text-align: left;
    font: 600 13px/1 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cream);
    padding: 6px 16px;
  }
  td { background: var(--cream); padding: 10px 16px; }
  td:first-child { border-radius: 999px 0 0 999px; }
  td:last-child { border-radius: 0 999px 999px 0; font-weight: 700; }
</style>
