---
import Wave from './Wave.astro';
import Icon from './Icon.astro';
import { site, igHandle, igLink, mailLink, waGeneral } from '../site.config';
---

<Wave variant="footer" />
<footer>
  <div class="container cols">
    <div class="talk">
      <h2>Conversemos</h2>
      <p>¿Dudas con tu talla o quieres encargar un par? Escríbenos y te respondemos.</p>
      <div class="socials">
        <a href={waGeneral} target="_blank" rel="noopener" aria-label="WhatsApp" class="round round--wa">
          <Icon name="whatsapp" size={26} color="var(--ink)" />
        </a>
        <a href={igLink} target="_blank" rel="noopener" aria-label="Instagram" class="round round--ig">
          <Icon name="instagram" size={24} color="var(--ink)" strokeWidth={2.4} />
        </a>
      </div>
    </div>
    <div class="follow">
      <span class="label">Síguenos</span>
      <a href={igLink} target="_blank" rel="noopener" class="handle">{igHandle}</a>
      <a href={mailLink} class="email">{site.email}</a>
      <span>Isla Teja, Valdivia · Chile</span>
    </div>
  </div>
  <div class="container legal">© {new Date().getFullYear()} Enraíza · Calzado respetuoso hecho a mano</div>
</footer>

<style>
  footer { background: var(--ink); color: var(--cream); }
  .cols {
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 40px;
  }
  .talk { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  h2 { font-size: clamp(32px, 3.6vw, 48px); color: var(--cream); }
  .talk p { font-size: 17px; max-width: 34ch; color: var(--sage-pale); }
  .socials { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .round {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-decoration: none;
    transition: background-color var(--ease);
  }
  .round--wa { background: var(--orange); }
  .round--wa:hover { background: var(--orange-hover); }
  .round--ig { background: var(--sage-light); }
  .round--ig:hover { background: var(--sage-pale); }
  .follow { display: flex; flex-direction: column; gap: 10px; font-size: 16px; color: var(--sage-pale); }
  .label {
    font: 600 13px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-light);
  }
  .follow a { text-decoration: none; transition: color var(--ease); }
  .follow a:hover { color: var(--orange); }
  .handle { color: var(--cream); font: 400 24px/1.2 var(--font-display); }
  .email { color: var(--sage-pale); margin-top: 10px; }
  .legal { padding-top: 20px; padding-bottom: 32px; font-size: 14px; color: var(--sage-light); }
</style>
