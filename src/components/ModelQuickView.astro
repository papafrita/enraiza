---
import { Picture } from 'astro:assets';
import { shapes, modeloHref, sizes, soles, type Modelo } from '../lib/modelos';
import { site } from '../site.config';

interface Props {
  modelo: Modelo;
  offset?: string;
}
const { modelo, offset = '0px' } = Astro.props;
const m = modelo.data;
const dialogId = `modelo-${modelo.id}`;
const titleId = `${dialogId}-titulo`;
const whatsappNumber = site.whatsapp.replace(/\D/g, '');
const defaultMessage = `Hola Enraíza, quiero reservar el modelo ${m.name}, con ${soles[0].label.toLowerCase()}.`;
const waHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<button
  type="button"
  class="model-card offset"
  style={`--offset:${offset}`}
  data-open-dialog={dialogId}
  aria-haspopup="dialog"
>
  <Picture
    src={m.image}
    alt={m.alt}
    widths={[320, 640]}
    sizes="(min-width: 1100px) 290px, (min-width: 640px) 45vw, 100vw"
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    style={`aspect-ratio:1/1;border-radius:${shapes[m.shape]}`}
  />
  <span class="text">
    <span class="name">{m.name}</span>
    <span class="kind">{m.kind} · Ver detalle</span>
  </span>
</button>

<dialog id={dialogId} class="quickview" aria-labelledby={titleId} data-quickview>
  <div class="quickview-inner" data-quickview-picker data-model={m.name} data-wa={whatsappNumber}>
    <button type="button" class="close" data-close aria-label={`Cerrar detalle de ${m.name}`}>✕</button>
    <div class="quickview-media">
      <Picture
        src={m.image}
        alt={m.alt}
        widths={[480, 760]}
        sizes="(min-width: 940px) 420px, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        style={`aspect-ratio:1;border-radius:${shapes[m.shape]}`}
      />
    </div>
    <div class="quickview-info">
      <span class="kicker">{m.kind}</span>
      <h3 id={titleId}>{m.name}</h3>
      <p class="lead">{m.description}</p>
      <ul class="features">
        {m.features.map((f) => <li>{f}</li>)}
      </ul>

      <div class="group">
        <span class="group-title">Tu talla</span>
        <div class="chips">
          {sizes.map((s) => (
            <button type="button" class="chip" data-size={s.talla} aria-pressed="false">{s.talla}</button>
          ))}
        </div>
      </div>

      <div class="group">
        <span class="group-title">Tipo de suela</span>
        <div class="chips">
          {soles.map((s, i) => (
            <button type="button" class="chip sole" data-sole={s.label} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="sole-label">{s.label}</span>
              <span class="sole-hint">{s.hint}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="summary">
        <span data-summary aria-live="polite">{m.name} · talla por definir · {soles[0].label.toLowerCase()}</span>
        <div class="summary-actions">
          <a href={waHref} target="_blank" rel="noopener" class="btn btn--sage btn--sm" data-reserve>
            Reservar por WhatsApp
          </a>
          <a href={modeloHref(modelo)} class="detail-link">Ver ficha completa →</a>
        </div>
        <span class="note">Te confirmamos medidas, cuero disponible y plazo antes de reservar.</span>
      </div>
    </div>
  </div>
</dialog>

<style>
  .model-card {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink);
    transition: color var(--ease), transform var(--ease);
  }
  .model-card:hover { color: var(--sage-dark); }
  .model-card:hover :global(img) { transform: scale(1.015); }
  .model-card :global(img) { width: 100%; object-fit: cover; transition: transform var(--ease); }
  .text { display: flex; flex-direction: column; gap: 4px; padding: 0 10px; }
  .name { font: 400 28px/1.1 var(--font-display); }
  .kind { font-size: 15px; color: var(--ink-soft); }

  .quickview {
    border: 0;
    padding: 0;
    width: min(920px, calc(100vw - 32px));
    max-height: min(90vh, 900px);
    border-radius: 40px;
    background: var(--cream);
    color: var(--ink);
  }
  .quickview::backdrop { background: rgba(31, 58, 49, 0.55); }
  .quickview-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(20px, 3vw, 36px);
    padding: clamp(20px, 3vw, 36px);
    overflow: auto;
    max-height: min(90vh, 900px);
  }
  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    cursor: pointer;
    background: var(--ink);
    color: var(--cream);
    font-size: 18px;
    line-height: 1;
  }
  .close:hover { background: var(--ink-hover); }
  .quickview-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .quickview-info { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .quickview-info h3 { font-size: clamp(36px, 4vw, 56px); }
  .quickview-info .lead { font-size: 17px; }
  .features { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .features li { background: var(--sand); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 600; }

  .group { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .group-title { font: 400 20px/1.2 var(--font-display); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    cursor: pointer;
    min-width: 52px;
    height: 44px;
    border-radius: 999px;
    font: 600 15px/1 var(--font-body);
    border: 2px solid var(--sage);
    background: transparent;
    color: var(--ink);
    transition: background-color var(--ease), color var(--ease), border-color var(--ease);
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--sage); color: var(--cream); }
  .sole { height: auto; text-align: left; padding: 12px 18px; display: flex; flex-direction: column; gap: 2px; }
  .sole-label { font: 600 15px/1.2 var(--font-body); }
  .sole-hint { font: 400 13px/1.35 var(--font-body); }

  .summary {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    background: var(--sage-pale);
    border-radius: 28px 28px 28px 12px;
    padding: 20px;
    font-size: 15px;
  }
  .summary-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .detail-link { font: 600 15px/1 var(--font-body); }
  .note { font-size: 13px; color: var(--ink-soft); }

  @media (max-width: 760px) {
    .quickview-inner { grid-template-columns: 1fr; }
    .quickview-media :global(img) { aspect-ratio: 4/3; }
  }
</style>
