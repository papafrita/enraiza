---
import { Picture } from 'astro:assets';
import { shapes, modeloHref, type Modelo } from '../lib/modelos';

interface Props {
  modelo: Modelo;
  ratio?: '1/1' | '4/3';
  offset?: string;
}
const { modelo, ratio = '1/1', offset = '0px' } = Astro.props;
const m = modelo.data;
---

<a href={modeloHref(modelo)} class="model-card offset" style={`--offset:${offset}`}>
  <Picture
    src={m.image}
    alt={m.alt}
    widths={[320, 640]}
    sizes="(min-width: 1100px) 290px, (min-width: 640px) 45vw, 100vw"
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    style={`aspect-ratio:${ratio};border-radius:${shapes[m.shape]}`}
  />
  <span class="text">
    <span class:list={['name', { 'name--sm': ratio === '4/3' }]}>{m.name}</span>
    <span class="kind">{m.kind}</span>
  </span>
</a>

<style>
  .model-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink);
    transition: color var(--ease);
  }
  .model-card:hover { color: var(--sage-dark); }
  .model-card :global(img) { width: 100%; object-fit: cover; }
  .text { display: flex; flex-direction: column; gap: 4px; padding: 0 10px; }
  .name { font: 400 28px/1.1 var(--font-display); }
  .name--sm { font-size: 26px; }
  .kind { font-size: 15px; color: var(--ink-soft); }
</style>
